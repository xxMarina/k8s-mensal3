# Configuracoes do Banco de Dados
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/marmitech}
spring.datasource.username=${DB_USER:usuario_exemplo}
spring.datasource.password=${DB_PASS:senha_exemplo}
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
server.port=${PORT:8080}
app.cors.origins=${CORS_ORIGINS:http://localhost:4200}

# Autenticacao JWT
app.jwt.secret=${JWT_SECRET:chave_secreta_para_desenvolvimento}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:86400000}

# Graceful Shutdown
server.shutdown=graceful
spring.lifecycle.timeout-per-shutdown-phase=30s
